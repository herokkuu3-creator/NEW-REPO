# ----------------------------------------------------------------------------
# LeetCode Daily Agent — environment template
# Copy to .env locally. On Render, set these in the service's Environment tab.
# ----------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Render PostgreSQL connection string (Internal Database URL on Render)
DATABASE_URL="postgresql://user:password@host:5432/leetcode_agent"

# --- Browser / authentication ----------------------------------------------
# Render FREE tier (no persistent disk, ephemeral FS): the file paths are
# scratch only — the DURABLE storageState copy lives in Postgres, uploaded
# via POST /admin/storage-state (see README §5).
BROWSER_PROFILE_PATH="/tmp/browser-profile"
STORAGE_STATE_PATH="/tmp/storage-state.json"
# Local defaults (used by `npm run auth:setup`):
# BROWSER_PROFILE_PATH="./local-auth/browser-profile"
# STORAGE_STATE_PATH="./local-auth/storage-state.json"

# Headless in production; headed locally is fine for debugging
HEADLESS=true
# Diagnostics bundles (screenshots etc.) — ephemeral on free tier; the
# Cloudflare screenshot is also sent to Telegram so it survives spin-down.
DIAGNOSTICS_DIR="/tmp/diagnostics"
# Escape hatch for Chromium OOM on the 512MB free instance (stability cost)
CHROMIUM_SINGLE_PROCESS=false

# --- Scheduler --------------------------------------------------------------
DAILY_RUN_HOUR=9
DAILY_RUN_MINUTE=0
TIMEZONE="Asia/Kolkata"
# Run immediately on boot? On Render free tier set true: the daily trigger
# arrives as an HTTP ping that cold-starts the service, and this converts
# that wake-up into the daily run. Keep-alive setups can leave it false —
# the internal node-cron fires on schedule while the service is awake.
RUN_ON_BOOT=true

# --- Solution source ----------------------------------------------------------
# walkccc (default): fetch the curated C++ solution from
#   https://walkccc.me/LeetCode/problems/<question-number>/
# — NO LLM key needed. The question number comes from LeetCode's own GraphQL.
# llm: generate the solution with an LLM instead (fill the LLM section below).
SOLUTION_SOURCE=walkccc
WALKCCC_BASE_URL="https://walkccc.me/LeetCode"

# --- Transport ----------------------------------------------------------------
# api (default): drive LeetCode's own GraphQL + submit endpoints. Never loads
#   an HTML page, so Cloudflare's page-level challenge is not triggered — this
#   is the fix for "Just a moment..." / CLOUDFLARE_VERIFICATION_REQUIRED on
#   datacenter IPs such as Render's.
# browser: navigate the UI with Playwright (fills the editor; needs the HTML
#   pages to load unchallenged).
TRANSPORT=api

# --- LLM (only used when SOLUTION_SOURCE=llm; Google Gemini free tier) --------
LLM_PROVIDER=gemini
LLM_API_KEY=""
# GEMINI_API_KEY=""   # accepted as an alternative name for the same key
LLM_MODEL="gemini-3.5-flash"

# Optional: only needed for OpenAI-compatible gateways / proxies.
LLM_BASE_URL=""
LLM_TIMEOUT_MS=120000
# Thinking tokens count against this budget — keep it generous on reasoning models.
LLM_MAX_TOKENS=8192
# Optional: minimal | low | medium | high | none  (none disables thinking on 2.5 models)
# Leave unset to use the model's own default.
# LLM_REASONING_EFFORT=low
# Optional: only sent when set. Gemini thinking models are best left at their default.
# LLM_TEMPERATURE=0.2
MAX_SOLUTION_RETRIES=3
# Language submitted to LeetCode: cpp (default — matches walkccc) | javascript | python3 | typescript
LEETCODE_LANGUAGE=cpp

# --- AI solution articles (independent of code generation; opt-in accounts) ---
# Bootstrap article generation from one key, or use the plural variable for a comma-separated pool.
# Keys added with /addsolutionkeys are encrypted and persisted in the bot database.
SOLUTION_POST_API_KEY=""
SOLUTION_POST_API_KEYS=""
BAZAARLINK_API_KEY=""
BAZAARLINK_API_KEYS=""
SOLUTION_POST_BASE_URL="https://api.bazaarlink.ai/v1"
# Economical models only. Qwen names are accepted when the provider exposes them.
SOLUTION_POST_MODELS="qwen/qwen3.7-flash:free"
SOLUTION_POST_TIMEOUT_MS=90000
SOLUTION_POST_MODEL_TIMEOUTS="{}"
SOLUTION_POST_RETRIES=1
SOLUTION_POST_MAX_TOKENS=8192
SOLUTION_POST_AUTO_PUBLISH=true
# Account scheduling is stored in SolutionPostPreference via the CLI/admin API.
# No selected accounts by default. Fixed 06:00 Asia/Kolkata. Set the flag false
# to retain generated drafts for manual approval instead of posting them.

# --- Notifications ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Command bot (long polling — no webhook setup needed). Adds /renew (session
# renewal from cookies you paste), /status, /help. On by default when the two
# values above are set; only messages from TELEGRAM_CHAT_ID are accepted.
TELEGRAM_COMMANDS=true

# --- API ----------------------------------------------------------------------
# Port for the health server (Render sets PORT automatically — leave it alone there)
PORT=3001
# Bearer token protecting admin endpoints (POST /admin/run-now, /admin/storage-state)
SETUP_TOKEN="change-me-to-a-long-random-string"
# PIN required to view GET /health details (browser PIN form, or header
# X-PIN-Code). Without it /health only returns {"status":"ok"}.
PIN_CODE=""
# Public base URL used to build the /renew sign-in link in Telegram alerts.
# Render sets RENDER_EXTERNAL_URL automatically — leave empty there; set only
# for a custom domain or local testing (e.g. http://localhost:3001).
PUBLIC_URL=""

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=info

# --- Codeforces isolated submitter --------------------------------------------
# Set the same token on the main service and the isolated submitter.
CODEFORCES_SUBMITTER_URL=""
CODEFORCES_SUBMITTER_TOKEN=""
CODEFORCES_RUNNER_REPOSITORY=""
GITHUB_DISPATCH_TOKEN=""
# Set CODEFORCES_RUNNER_MODE=local on the isolated Render service to have this
# PC claim jobs over HTTPS instead of GitHub Actions. This token stays only on
# the PC and Render; it is separate from CODEFORCES_SUBMITTER_TOKEN.
CODEFORCES_RUNNER_MODE="github"
CODEFORCES_LOCAL_RUNNER_TOKEN=""
CODEFORCES_LOCAL_RUNNER_POLL_MS=3000
# Browser attempts have a fixed 8-minute budget and at most 3 total attempts.
# Set these on the isolated submitter service:
CODEFORCES_TURNSTILE_WAIT_MS=20000
CODEFORCES_CHALLENGE_WAIT_MS=10000
# Optional outbound proxy. Takes precedence over automatic WARP setup.
CODEFORCES_PROXY=""
WARP_ENABLED=true
# Optional base64 of a working wgcf-profile.conf; treat it as a secret.
# Reusing a profile avoids WARP registration on every Render cold start.
WARP_PROFILE_B64=""
# Codeforces verification is completed by the site's own widget, without external solvers.

# --- Multi-account ------------------------------------------------------------
# Optional CodeChef accounts. Store the actual values only in Render's environment.
# CODECHEF_1=username::password
# CODECHEF_2=another_username::password
# /codechef triggers the same daily worker manually. C++ sources ship in the image.

# Accounts live in Postgres (Account table) — manage them via the admin API:
#   POST   /admin/accounts         {"label":"main","cookies":"LEETCODE_SESSION=...; csrftoken=..."}
#   GET    /admin/accounts         list accounts + cookie status (no secrets)
#   DELETE /admin/accounts/<label> remove one
#   GET    /admin/report           the latest multi-account report
# or via Telegram: /renew, /renew <label>, /accounts.
# The legacy POST /admin/storage-state and /renew flow keep working and are
# synced into a "default" account on the first run.
