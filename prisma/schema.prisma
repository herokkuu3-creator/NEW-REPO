generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per cookie-set ("account") the agent manages. The storageState
/// JSON is the credential (stored in Postgres — the durable store on
/// Render's free tier) and is a SECRET: never expose it through the API.
/// username/status are refreshed on every run.
model Account {
  id            String        @id @default(cuid())
  label         String        @unique // user-chosen name, e.g. "main"
  storageState  String        @db.Text // Playwright storageState JSON
  username      String? // discovered from LeetCode's userStatus query
  status        AccountStatus @default(UNKNOWN)
  lastCheckedAt DateTime? // last session check
  lastRunAt     DateTime? // last attempt at the daily challenge
  lastResult    String? // last RunState value for this account
  lastError     String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  runs          DailyRun[]

  @@index([status])
}

/// One row per account per daily-challenge execution. (accountId, date) is
/// unique, which makes duplicate submissions impossible even across worker
/// restarts — independently for every account.
model DailyRun {
  id               String    @id @default(cuid())
  accountId        String
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date             String // YYYY-MM-DD (configured timezone)
  problemSlug      String
  title            String
  difficulty       String
  language         String
  solution         String?   @db.Text
  submissionId     String?
  submissionStatus String?
  runtime          String?
  memory           String?
  state            RunState
  error            String?   @db.Text
  attempts         Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([accountId, date])
  @@index([date])
  @@index([state])
  @@index([createdAt])
}

/// Small key/value store for cross-restart system state:
/// auth status, last error, last run summary — powers GET /health.
model SystemState {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

enum RunState {
  PENDING
  AUTHENTICATION_REQUIRED
  CLOUDFLARE_VERIFICATION_REQUIRED
  DAILY_PROBLEM_NOT_FOUND
  PROBLEM_PARSE_FAILED
  LLM_ERROR
  SOLUTION_VALIDATION_FAILED
  SUBMISSION_ERROR
  SUBMISSION_REJECTED
  SUCCESS
}

/// Per-account cookie health. UNKNOWN = stored but not yet verified;
/// ACTIVE = verified signed-in on the last run; EXPIRED = LeetCode reported
/// the session signed out; DISABLED = user paused this account.
enum AccountStatus {
  UNKNOWN
  ACTIVE
  EXPIRED
  REJECTED
  DISABLED
}
// ---------------------------------------------------------------------------
// Codeforces integration — deliberately separate from LeetCode Account/DailyRun
// ---------------------------------------------------------------------------
model CodeforcesAccount {
  id                 String                  @id @default(cuid())
  label              String                  @unique
  storageState       String                  @db.Text
  username           String?
  status             CodeforcesAccountStatus @default(UNKNOWN)
  lastCheckedAt      DateTime?
  lastSubmissionDate String?
  lastSubmissionId   String?
  lastVerdict        String?
  lastError          String?                 @db.Text
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  progress            CodeforcesProgress?

  @@index([status])
}

model CodeforcesProgress {
  accountId         String            @id
  account            CodeforcesAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nextKey           String?
  lastCompletedKey  String?
  lastCompletedAt   DateTime?
  lastAttemptDate   String?
  lastAttemptKey    String?
  lastSubmissionId  String?
  lastVerdict       String?
  updatedAt         DateTime          @updatedAt
}

/// Audit of every supported source file. NON_CODEFORCES and UNRESOLVED files
/// remain visible instead of silently disappearing from the queue.
model CodeforcesSourceAudit {
  path          String               @id
  fileName      String
  language      String
  kind          CodeforcesSourceKind
  contestId     Int?
  problemIndex  String?
  problemUrl    String?
  externalUrl   String?
  interactive   Boolean              @default(false)
  gym           Boolean              @default(false)
  reason        String               @db.Text
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([kind])
  @@index([contestId])
}

enum CodeforcesAccountStatus {
  UNKNOWN
  ACTIVE
  EXPIRED
  REJECTED
  DISABLED
}

enum CodeforcesSourceKind {
  CODEFORCES
  NON_CODEFORCES
  UNRESOLVED
}

enum CodeChefSourceKind {
  CODECHEF
  UNRESOLVED
}

model CodeChefAccount {
  id                 String               @id @default(cuid())
  label              String               @unique
  storageState       String               @db.Text
  username           String?
  status             CodeChefAccountStatus @default(UNKNOWN)
  lastCheckedAt      DateTime?
  lastSubmissionDate String?
  lastSubmissionId   String?
  lastVerdict        String?
  lastError          String?              @db.Text
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  progress           CodeChefProgress?

  @@index([status])
}

model CodeChefProgress {
  accountId         String          @id
  account           CodeChefAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nextKey           String?
  lastCompletedKey  String?
  lastCompletedAt   DateTime?
  lastAttemptDate   String?
  lastAttemptKey    String?
  lastSubmissionId  String?
  lastVerdict       String?
  updatedAt         DateTime        @updatedAt
}

model CodeChefSourceAudit {
  path          String             @id
  fileName      String
  language      String
  kind          CodeChefSourceKind
  problemCode   String?
  problemUrl    String?
  reason        String             @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([kind])
}

enum CodeChefAccountStatus {
  UNKNOWN
  ACTIVE
  EXPIRED
  REJECTED
  DISABLED
}

